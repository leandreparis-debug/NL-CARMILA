# Configuration de News Franchise.
# Copiez ce fichier en « .env » (dans le même dossier) puis modifiez les valeurs voulues.
# Une variable absente ou vide prend sa valeur par défaut.
# Le fichier .env n'est jamais versionné : il peut contenir des informations propres à votre poste.

# Dossier des données locales (base de données, photos, exports, rapports, journaux).
# Défaut : %LOCALAPPDATA%\NewsFranchise sous Windows, ~/.local/share/news-franchise ailleurs.
# Évitez un dossier synchronisé par OneDrive (Documents, Bureau...).
# NF_DATA_DIR=

# Port du serveur web local (entre 1024 et 65535). Défaut : 5000
# L'application écoute toujours uniquement sur 127.0.0.1 (non modifiable).
# NF_PORT=5000

# Mode debug de Flask (true/false). Défaut : false
# À n'activer que pour le développement : il affiche des détails techniques dans le navigateur.
# NF_DEBUG=false

# Ouvrir automatiquement le navigateur au lancement (true/false). Défaut : true
# NF_OPEN_BROWSER=true

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR ou CRITICAL. Défaut : INFO
# NF_LOG_LEVEL=INFO
